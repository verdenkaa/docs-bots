# Reference for manual setup. The manager generates these on first run.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
GRAFANA_PASSWORD=
S3_SECRET_KEY=

# S3 / RustFS access key (also the Console login). The manager generates the secret.
S3_ACCESS_KEY=rag

# Leave blank to build the local scaffold. Set a tag or digest to use a different image.
CORE_IMAGE=
WORKER_IMAGE=

# Token issued by @BotFather. Compose passes it to core.
TELEGRAM_BOT_TOKEN=

# Optional. A path on the engine host, not the Windows/macOS client.
# ALLOY_SOCKET=/var/run/docker.sock
# GRAFANA_PORT=3300
# LOCUST_PORT=8089
# ALLOY_PORT=12345
# CORE_PORT=8000
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
