# Единая конфигурация проекта. Рабочий файл: .env в корне репозитория.
# Manager, Compose и Python читают этот источник. См. README.md.
# RAG_ENV_FILE можно задать в окружении процесса для другого абсолютного пути.
# Значения ниже для сети Compose; при запуске Python на хосте замените имена
# postgres/rabbitmq/redis/qdrant/s3 на localhost и соответствующие опубликованные порты.
# Формат: python-dotenv / Pydantic Settings / Compose .env, UTF-8.
# Не передавайте этот файл целиком браузеру или как Docker --env-file без обработки.
# Секреты заполняйте только в игнорируемом Git файле .env.
# Закомментированные optional/required параметры включайте после заполнения.

# PostgreSQL: логин, пароль, база и подключение приложения.
PGHOST=postgres
PGPORT=5432
PGDATABASE=rag
PGUSER=rag
PGPASSWORD=
RAG_PG_SCHEMA=public
RAG_PG_POOL_SIZE=10
POSTGRES_PORT=5432

# RabbitMQ: порт подключения приложения отделён от порта публикации на хосте.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_PUBLISHED_PORT=5672
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=
RAG_RABBITMQ_VHOST=/
RAG_QUEUE_PREFIX=
RAG_BROKER_RETRY_S=1
RAG_PREFETCH=4
RAG_BATCH_SIZE=100

# Redis: текущий сервер работает без ACL/пароля. Приложение читает только URL.
# При включённой авторизации URL имеет вид redis://login:password@redis:6379/0.
# Логин и пароль в URL должны быть URL-encoded; отдельного загрузчика пары пока нет.
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
RAG_CACHE_PREFIX=rag:exact:v2:
RAG_CACHE_TTL_S=3600

# Qdrant: собственного логина нет, доступ по необязательному API key.
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# RAG_QDRANT_API_KEY=  # optional: не включать пустое значение вместо отсутствующего
RAG_CHUNKS_COLLECTION=document_chunks
RAG_TOPICS_COLLECTION=topic_questions

# S3 / RustFS: access key является также логином консоли.
S3_ENDPOINT_URL=http://s3:9000
S3_ACCESS_KEY=rag
S3_SECRET_KEY=
S3_REGION=us-east-1
RAG_S3_BUCKET=rag-images
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Telegram и админ-панель бота (не путать с паролем сайта документации).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
RAG_TELEGRAM_BASE_URL=https://api.telegram.org
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Runtime: сроки, повторы, ограничение нагрузки и завершение процессов.
RAG_IO_TIMEOUT_S=10
RAG_QUESTION_TIMEOUT_S=120
RAG_DELIVERY_TIMEOUT_S=60
RAG_INGESTION_TIMEOUT_S=600
RAG_MAX_PENDING_REQUESTS=1000
RAG_RECOVERY_WINDOW_S=60
RAG_RELAY_INTERVAL_S=1
RAG_RECOVERY_INTERVAL_S=30
RAG_SHUTDOWN_TIMEOUT_S=15
RAG_STARTUP_TIMEOUT_S=120

# Рабочие тома и подготовка изображений; для хоста укажите доступные локальные пути.
WORKER_SPOOL_DIR=/var/lib/rag/spool
RAG_MAX_MARKDOWN_BYTES=20971520
RAG_MAX_PREPARED_BYTES=268435456
RAG_MAX_IMAGE_BYTES=20971520
RAG_PHOTO_MAX_PIXELS=25000000
RAG_PHOTO_MEMORY_BYTES=536870912
RAG_PHOTO_TIMEOUT_S=15

# Searcher и профиль индекса. Профиль/размерность обязаны совпадать с bindings и индексом.
# Конкретные модели и профиль команды не выбраны этим файлом.
RAG_EMBEDDING_PROFILE=
RAG_EMBEDDING_DIMENSIONS=1024
RAG_PREPARATION_PROFILE=ingestion-v1
RAG_SEARCH_MODE=hybrid
RAG_SEARCH_CANDIDATE_LIMIT=10
RAG_SEARCH_TOP_K=3
# RAG_SEARCH_SCORE_THRESHOLD=  # optional float; отсутствие отключает порог
RAG_EMBEDDING_TIMEOUT_S=5
RAG_RERANK_TIMEOUT_S=5
RAG_USE_RERANKER=false
RAG_DENSE_WEIGHT=1
RAG_LEXICAL_WEIGHT=1
RAG_PRIORITY_LEXICAL_WEIGHT=2
RAG_RRF_K=60
RAG_TEXT_LANGUAGE=russian

# RAG Core: единый файл с приоритетом окружения процесса.
RAG_CORE_CACHE_TIMEOUT_S=0.25
RAG_CORE_GENERATION_TIMEOUT_S=60
RAG_CORE_OCR_TIMEOUT_S=30
RAG_CORE_MAX_INPUT_BYTES=12000
RAG_CORE_MAX_OUTPUT_TOKENS=1024
RAG_CORE_TEMPERATURE=0
RAG_CORE_MAX_ATTEMPTS=3
RAG_CORE_RETRY_DELAY_S=5

# Guardrails: текущие технические defaults; пороги требуют оценки на примерах команды.
RAG_GUARDRAILS_MAX_QUESTION_CHARS=4000
RAG_GUARDRAILS_DETECTOR_TIMEOUT_S=5
RAG_GUARDRAILS_EMBEDDING_TIMEOUT_S=5
RAG_GUARDRAILS_TOPIC_TIMEOUT_S=5
RAG_GUARDRAILS_TOPIC_THRESHOLD=0.3
RAG_GUARDRAILS_INJECTION_SCORE_THRESHOLDS='{}'

# Ingestion HTTP: токен обязателен для запуска HTTP-приложения.
RAG_INGESTION_TOKEN=
RAG_INGESTION_MAX_UPLOAD_BYTES=20971520
RAG_INGESTION_UPLOAD_TIMEOUT_S=600

# Document Converter. HTTP-приём отдельно ограничен 20 MiB, конвертер — 50 MiB.
RAG_CONVERTER_MAX_UPLOAD_BYTES=52428800
RAG_CONVERTER_MAX_MARKDOWN_BYTES=20971520
RAG_CONVERTER_MAX_PARSER_OUTPUT_BYTES=134217728
RAG_CONVERTER_MAX_IMAGES=500
RAG_CONVERTER_MAX_IMAGE_BYTES=20971520
RAG_CONVERTER_MAX_DESCRIPTION_CHARS=2000
RAG_CONVERTER_TOTAL_TIMEOUT_S=1800
RAG_CONVERTER_PARSE_TIMEOUT_S=300
RAG_CONVERTER_PARSE_MEMORY_BYTES=4294967296
RAG_CONVERTER_OCR_TIMEOUT_S=30
RAG_CONVERTER_DESCRIBE_TIMEOUT_S=60
RAG_CONVERTER_MODEL_CONCURRENCY=4

# Разбиение Markdown.
INGESTION_CHUNK_CHARACTERS=2000
INGESTION_CHUNK_OVERLAP=200

# Ingestion Worker: REQUIRED — заполнить из проверенного модельного профиля.
# Все семь полей обязательны; численные модельные лимиты не придуманы автоматически.
# INGESTION_EMBEDDING_PROFILE=
# INGESTION_GENERATION_PROFILE=
# INGESTION_PREPARATION_PROFILE=
# INGESTION_EMBEDDING_DIMENSIONS=
# INGESTION_EMBEDDING_INPUT_CHARACTERS=
# INGESTION_TOPIC_INPUT_CHARACTERS=
# INGESTION_GENERATION_MAX_OUTPUT_TOKENS=
INGESTION_MAX_ATTEMPTS=3
INGESTION_STEP_TIMEOUT_S=10
INGESTION_EMBEDDING_TIMEOUT_S=30
INGESTION_GENERATION_TIMEOUT_S=60
INGESTION_INDEX_TIMEOUT_S=30
INGESTION_RETRY_INITIAL_S=1
INGESTION_RETRY_MAX_S=60
INGESTION_EMBEDDING_BATCH_SIZE=32
INGESTION_TOPIC_QUESTIONS_PER_PORTION=8
INGESTION_MAX_TOPIC_QUESTIONS=10000
INGESTION_MAX_QUESTION_CHARACTERS=1000
INGESTION_MAX_RESPONSE_CHARACTERS=262144
INGESTION_MAX_DOCUMENT_CHARACTERS=2000000
INGESTION_MAX_CHUNKS=10000
INGESTION_CLEANUP_LIMIT=20
INGESTION_CLEANUP_TIMEOUT_S=10

# Model Gateway: JSON на одной строке, в одинарных dotenv-кавычках.
# Пустая карта не запускает модели. Для каждой роли binding задаёт profile_id,
# execution, provider, model_id, model_revision, endpoint, credential_env,
# max_concurrency, embedding_dimensions. Значение секрета храните отдельно здесь,
# под тем именем env, которое указано в credential_env; Gateway подхватывает его при запуске моделей.
RAG_MODEL_BINDINGS='{}'
# Explicit minimal text-only test profile; photo questions require OCR otherwise.
RAG_TEXT_ONLY=false
MODEL_GATEWAY_PROVIDER_MODULES='[]'
MODEL_GATEWAY_LOCAL_LOADERS='{}'
MODEL_GATEWAY_CACHE_DIR=/var/lib/rag/models
# MODEL_GATEWAY_LOCAL_MEMORY_BYTES=  # optional positive integer
MODEL_GATEWAY_QUEUE_SIZE=32
MODEL_GATEWAY_STARTUP_TIMEOUT_S=120
MODEL_GATEWAY_SHUTDOWN_TIMEOUT_S=15
MODEL_GATEWAY_STOP_GRACE_S=1
MODEL_GATEWAY_MAX_BATCH_ITEMS=128
MODEL_GATEWAY_MAX_TEXT_CHARS=1000000
MODEL_GATEWAY_MAX_IMAGE_BYTES=20971520
MODEL_GATEWAY_MAX_MESSAGE_BYTES=67108864
MODEL_GATEWAY_MAX_LOCAL_WORKERS=4
MODEL_GATEWAY_CACHE_SIZE=256
MODEL_GATEWAY_CACHE_TTL_S=60
MODEL_GATEWAY_COORDINATION_POLL_S=0.1
OLLAMA_GATEWAY_KEEP_ALIVE=0
OLLAMA_GATEWAY_TEXT_CONTEXT_LENGTH=2048
OLLAMA_GATEWAY_GENERATION_JSON=false
# При необходимости передаются локальным backend из окружения процесса:
# CUDA_VISIBLE_DEVICES=
# HF_HOME=
# TORCH_HOME=
# TRANSFORMERS_CACHE=

# Образы, опубликованные порты и мониторинг Compose.
CORE_IMAGE=
WORKER_IMAGE=
CORE_PORT=8000
GRAFANA_PORT=3300
GRAFANA_PASSWORD=
# Логин администратора Grafana, передаётся как GF_SECURITY_ADMIN_USER.
GRAFANA_USER=admin
LOCUST_PORT=8089
ALLOY_PORT=12345
ALLOY_SOCKET=/var/run/docker.sock
# Имя проекта общее для менеджера, Compose и фильтра логов Alloy.
RAG_COMPOSE_PROJECT=rag-hackathon

# Сайт docs/ использует собственное окружение Vercel; см. docs/.env.example.

# Серверный запуск из корня: docker compose up -d --build.
# Публичный IPv4 или домен; TELEGRAM_WEBHOOK_URL выше = https://PUBLIC_HOST без пути.
# Для IP автоматически выпускается короткоживущий сертификат с продлением.
PUBLIC_HOST=
# Email необязателен; при отсутствии ACME-аккаунт создаётся без email.
ACME_EMAIL=
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
API_WORKERS=2
INGESTION_HTTP_WORKERS=1
# Должен быть больше RAG_INGESTION_UPLOAD_TIMEOUT_S.
INGESTION_PROXY_TIMEOUT_S=660
MODEL_DOWNLOAD_TIMEOUT_S=3600
OLLAMA_IMAGE=ollama/ollama:0.23.0
# Для сервера CPU 32 ядра / 64 GiB оставляем ресурсы остальным сервисам.
OLLAMA_CPUS=28
OLLAMA_MEMORY_LIMIT=48g
# Необязательный первичный допуск. Пустой список: добавление через /admin.
# Имена из списка получают enabled=true при каждом запуске prepare.
RAG_BOOTSTRAP_USERNAMES='[]'
