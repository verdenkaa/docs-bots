discovery.docker "project" {
  host = "unix:///run/container-engine.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("RAG_COMPOSE_PROJECT")]
  }
}

discovery.relabel "services" {
  targets = discovery.docker.project.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "alloy|loki|grafana"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "project" {
  host       = "unix:///run/container-engine.sock"
  targets    = discovery.relabel.services.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
